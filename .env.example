# Copy to .env and fill in, then: chmod 600 .env
# Only WHATSAPP_MCP_TOKEN is required. Everything else has a working default.

# --- Required ----------------------------------------------------------------
# The single owner credential. Every MCP request must send it as:
#   Authorization: Bearer <this>
# Generate a fresh one:  printf 'wamcp_%s\n' "$(openssl rand -hex 32)"
WHATSAPP_MCP_TOKEN=

# --- Toolset -----------------------------------------------------------------
# minimal (default): 29 core tools + find_tool/call_tool, ~8k always-on tokens.
# full: all 96 tools served directly, ~20k tokens, no meta-tools.
# WHATSAPP_MCP_TOOLSET=minimal

# --- Multiple tokens with scopes (optional) ----------------------------------
# Overrides WHATSAPP_MCP_TOKEN when set. Scopes: whatsapp:read, whatsapp:send,
# whatsapp:admin, whatsapp:full. A read-only token cannot send.
# WHATSAPP_MCP_TOKENS_JSON='{"wamcp_xxx":{"client_id":"reader","scopes":["whatsapp:read"]}}'

# --- Voice transcription (optional) ------------------------------------------
# Any key here enables the background transcription worker. Without one, the
# voice tools return "transcription disabled" rather than failing.
# SPEECHMATICS_API_KEYS=key1,key2
# GROQ_API_KEY=
# TRANSCRIBE_LANGUAGE=ar

# --- Semantic tool retrieval (optional) --------------------------------------
# Any one of these upgrades find_tool from lexical to hybrid lexical+semantic.
# No key means pure lexical, with zero behaviour change.
# VOYAGE_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# WHATSAPP_MCP_EMBED_WEIGHT=0.6

# --- Operational (optional) --------------------------------------------------
# WHATSAPP_MCP_LOG_LEVEL=INFO
# WHATSAPP_MEDIA_ROOTS=/data/media   # extra dirs a send tool may read from (colon-separated)
# WHATSAPP_MCP_AUDIT_LOG=/var/log/wamcp/audit.jsonl
# BRIDGE_MEDIA_TTL_DAYS=14           # downloaded-media reaper; 0 disables
# BRIDGE_LOG_MESSAGES=0              # 1 logs per message; off keeps content out of logs
